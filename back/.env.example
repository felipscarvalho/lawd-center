# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database (PostgreSQL)
DB_CONNECTION=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=lawd_center

# Primeiro administrador (usado pelo seeder: node ace db:seed)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Health check: se definido, /api/v1/health/ready exige o cabeçalho x-monitoring-secret com este valor
HEALTH_SECRET=

# CORS: origens do front aceitas em produção, separadas por vírgula (em desenvolvimento, qualquer uma)
CORS_ORIGIN=https://lawd.felipscarvalho.com.br
DRIVE_DISK=fs

# Front: endereço público usado nos links dos e-mails (ex.: convite para criar a senha)
FRONT_URL=http://localhost:3000

# E-mail (SMTP). Produção: SMTP do Google (smtp.gmail.com, porta 465) com uma senha de app da conta
# remetente (Conta Google > Segurança > Senhas de app; exige verificação em duas etapas).
# Desenvolvimento: um SMTP local como o Mailpit (localhost:1025), sem usuário e senha.
MAIL_MAILER=smtp
MAIL_FROM_NAME=Lawd Center
MAIL_FROM_ADDRESS=lawd@exemplo.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
